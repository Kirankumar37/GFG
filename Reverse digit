class Solution {
    public int reverse(int x) {
        int original=x;
        int ans=0;
        if(x<0){
            x=Math.abs(x);
        }
        while(x>0){
            int rem=x%10;
            ans=ans*10+rem;
            x/=10;
        }
        if(original<0){
            return -ans;
        }
        return ans;
    }
}
